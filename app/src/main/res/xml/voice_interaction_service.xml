<?xml version="1.0" encoding="utf-8"?>
<!--
  VoiceInteractionService descriptor: points the system to the session
  service that materializes assistant invocations, and declares that this
  service handles ASSIST intents (without supportsAssist some ROMs never
  list the service in the "Assist app" picker — the Android 11 bug).
-->
<voice-interaction-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:sessionService="com.example.assistant.MnemosyneSessionService"
    android:supportsAssist="true" />
