<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Assistant tool: close background apps (normal permission). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Health Connect (Android 9+ with the provider app; built in on 14+):
         read-only steps + sleep for the morning brief and weekly report. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!-- Realtime sync: 5-minute tick + per-reminder wake alarms survive reboots. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Smart location reminders (private app, data stays on device). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Hotword foreground service (microphone type) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Media/file search: granular media permissions (Android 13+) and the
         legacy blanket permission for older devices. Without these,
         MediaStore only returns files this app itself created, which made
         the device-wide file search look "broken". -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Habit engine: Bluetooth devices seen repeatedly (headphones, car…).
         Legacy BLUETOOTH for pre-S, runtime BLUETOOTH_CONNECT on S+. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!-- Android 11+ package visibility: lets the assistant "open <app>"
     * voice command resolve any installed launcher-capable app, and lets
     * SpeechEngineManager enumerate the installed recognition services
     * (Google Speech Services vs Samsung Voice Input vs others). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Health Connect (the Play Store provider app on Android 11):
             without this the sdkStatus check cannot see the installed
             package and the install button never clears. -->
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Eligibility path #2 for the assistant selector: apps that
                 handle ACTION_ASSIST also appear under Ajustes → Apps → Apps
                 predeterminadas → App de asistencia (Android 8-11), even on
                 ROMs that are slow to list VoiceInteractionServices. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- RECEIVE shares from any app: links, text, photos, audio, PDFs. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Software hotword listener: foreground service with the
             microphone type. Always runs on-device, no network needed. -->
        <service
            android:name=".speech.hotword.HotwordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- System-assistant integration: lets the user pick Mnemosyne as
             the default assistant (home long-press gesture). -->
        <service
            android:name=".assistant.MnemosyneVoiceInteractionService"
            android:exported="true"
            android:label="Asistente Mnemosyne"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>

        <service
            android:name=".assistant.MnemosyneSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Google At a Glance Android Home Screen Widget -->
        <receiver
            android:name=".widget.AtAGlanceWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/at_a_glance_widget_info" />
        </receiver>

        <!-- Realtime sync: 5-minute inexact tick + per-reminder wake alarms
             + re-arm after boot / app update. -->
        <receiver
            android:name=".sync.RealtimeSyncReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.SYNC_TICK" />
                <action android:name="com.example.REMINDER_DUE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Habit engine realtime collectors: exempted implicit broadcasts
             (power/alarm/timezone/boot) fire even when the process is asleep;
             unlock and screen events arrive via UsageStats replays instead. -->
        <receiver
            android:name=".habit.HabitEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Activity Recognition Transitions API (Android 10+, includes 11):
             ENTER/EXIT of vehicle/walking/running feeds the habit store and
             the spatial engine's travel-time estimates. -->
        <receiver
            android:name=".habit.ActivityTransitionsReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.habit.ACTIVITY_TRANSITION" />
            </intent-filter>
        </receiver>

        <!-- Morning brief (learned wake time) + weekly report (Sunday 19:00). -->
        <receiver
            android:name=".sync.BriefReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.sync.MORNING_BRIEF" />
                <action android:name="com.example.sync.WEEKLY_REPORT" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Habit engine: notification telemetry (opt-in special access).
             Stores ONLY package + timestamp + category — never content. -->
        <service
            android:name=".habit.HabitNotificationListener"
            android:exported="true"
            android:label="Telemetría de notificaciones de Mnemosyne"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Dynamic sun live wallpaper (Samsung-mode experiment, opt-in). -->
        <service
            android:name=".wallpaper.SunWallpaperService"
            android:enabled="true"
            android:exported="true"
            android:label="Sol de Mnemosyne"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/sun_wallpaper" />
        </service>
    </application>

</manifest>
